{
  "name": "Horizon Nepal API",
  "description": "Public REST API for Horizon Nepal's construction company website — architecture, engineering, and construction services across Nepal.",
  "baseUrl": "https://api.horizonnepalconstruction.com/api",
  "endpoints": [
    { "path": "/settings/", "methods": ["GET"], "description": "Site settings, social links, contact info, analytics scripts" },
    { "path": "/projects/", "methods": ["GET"], "description": "List of construction projects" },
    { "path": "/projects/{slug}/", "methods": ["GET"], "description": "Single project detail by slug" },
    { "path": "/blog/", "methods": ["GET"], "description": "Blog posts list (supports ?category=slug filter)" },
    { "path": "/blog/{slug}/", "methods": ["GET"], "description": "Single blog post by slug" },
    { "path": "/blog/categories/", "methods": ["GET"], "description": "Blog categories" },
    { "path": "/categories/blog", "methods": ["GET"], "description": "Public blog categories" },
    { "path": "/categories/project", "methods": ["GET"], "description": "Public project categories" },
    { "path": "/categories/project/{slug}", "methods": ["GET"], "description": "Project category detail" },
    { "path": "/categories/services", "methods": ["GET"], "description": "Service categories" },
    { "path": "/categories/services/{slug}", "methods": ["GET"], "description": "Service category detail" },
    { "path": "/faq/", "methods": ["GET"], "description": "FAQ items" },
    { "path": "/faq/groups/", "methods": ["GET"], "description": "FAQ groups by category" },
    { "path": "/team", "methods": ["GET"], "description": "Team members" },
    { "path": "/reviews/", "methods": ["GET", "POST"], "description": "Client reviews and testimonials" },
    { "path": "/pages/{slug}", "methods": ["GET"], "description": "CMS page content by slug" },
    { "path": "/media/banners/{slug}", "methods": ["GET"], "description": "Banner images by page slug" },
    { "path": "/models/", "methods": ["GET"], "description": "3D models list" },
    { "path": "/models/{slug}/", "methods": ["GET"], "description": "Single 3D model by slug" },
    { "path": "/models/designs/", "methods": ["GET"], "description": "Design model listings" },
    { "path": "/vastu/nav/", "methods": ["GET"], "description": "Vastu Shastra navigation structure" },
    { "path": "/vastu/{slug}/", "methods": ["GET"], "description": "Vastu Shastra item detail by slug" },
    { "path": "/building-permit/", "methods": ["GET"], "description": "Building permit workflow configuration" },
    { "path": "/calculator/materials/", "methods": ["GET"], "description": "Construction materials for cost estimation" },
    { "path": "/materials/", "methods": ["GET"], "description": "Construction material catalog" },
    { "path": "/materials/{slug}/", "methods": ["GET"], "description": "Single material detail by slug" },
    { "path": "/unit-converter/", "methods": ["GET"], "description": "Unit conversion tables" },
    { "path": "/unit-converter/{slug}/", "methods": ["GET"], "description": "Single unit conversion detail by slug" },
    { "path": "/vendors/", "methods": ["GET"], "description": "Construction vendor directory" },
    { "path": "/emi/banks", "methods": ["GET"], "description": "Home loan EMI bank rates" },
    { "path": "/consultation/", "methods": ["POST"], "description": "Submit consultation contact form (supports JSON and FormData with photos)" }
  ]
}
